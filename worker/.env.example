# Doorface worker — copy to .env and fill in (never commit .env)

# Video source — RTSP (Reolink), HTTP MJPEG (ESP32 /stream), etc.
# STREAM_URL=rtsp://doorbell.test:554/h264Preview_01_sub
STREAM_URL=http://mjpeg.test:81/stream
STREAM_USER=doorman
STREAM_PASSWORD=your-password-here

# Home Assistant notify webhook — full URL including secret id
HA_WEBHOOK_URL=http://192.168.x.x:8123/api/webhook/doorman_notify

# Optional tuning
# FACES_DIR=config/faces
# GALLERY_PATH=config/gallery.pkl
# RECOGNITION_THRESHOLD=0.4
# FRAMES_PER_EVENT=5

# HTTP server (Docker)
WORKER_HOST=0.0.0.0
WORKER_PORT=8768

# Match homelab user (deploy sets these from id -u / id -g on first .env create)
DOCKER_UID=1000
DOCKER_GID=1000

# Optional — require ?token=... or Authorization: Bearer on /enroll/* (LAN only)
# ENROLL_SECRET=change-me
