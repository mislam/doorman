# Video source — RTSP (Reolink), HTTP MJPEG (ESP32 /stream), etc.
# STREAM_URL=http://192.168.x.x:81/stream
STREAM_URL=rtsp://192.168.x.x:554/h264Preview_01_sub
STREAM_USER=doorman
STREAM_PASSWORD=your-password-here

# Recognition tuning
# FRAME_ENHANCE=clahe
# RECOGNITION_THRESHOLD=0.4
# FRAMES_PER_EVENT=5
HA_WEBHOOK_URL=http://192.168.x.x:8123/api/webhook/doorman_notify

# HTTP server (Docker — internal; Caddy publishes HTTPS on host :8768)
WORKER_HOST=0.0.0.0
WORKER_PORT=8768

# Homelab LAN IP — used in enroll TLS cert (SAN) on first deploy
ENROLL_LAN_IP=192.168.x.x
