# Doorface worker — copy to .env and fill in (never commit .env)

# Reolink doorbell RTSP (sub OK to start; main stream if faces too small)
RTSP_URL=rtsp://USER:PASS@192.168.x.x:554/h264Preview_01_sub

# Home Assistant notify webhook — full URL including secret id
HA_WEBHOOK_URL=http://192.168.x.x:8123/api/webhook/doorman_notify

# Optional tuning
# FACES_DIR=config/faces
# GALLERY_PATH=config/gallery.pkl
# RECOGNITION_THRESHOLD=0.4
# FRAMES_PER_EVENT=5

# HTTP server (Docker)
WORKER_HOST=0.0.0.0
WORKER_PORT=8768
